# Docker から host PC の Ollama へ接続するエンドポイント
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama 側で `ollama pull` 済みのモデル名
# tool calling を安定させたい場合は llama3.1:8b や qwen2.5:7b-instruct への切替を推奨
MODEL_NAME=gemma4

# tool calling のフォールバック制御
#   auto   : bind_tools が成功すれば native、失敗時のみ JSON フォールバック (既定)
#   always : 常にプロンプト + JSON 出力でツールを駆動 (gemma 系で native NG のとき)
#   never  : フォールバックを行わない
USE_TOOL_FALLBACK=auto
